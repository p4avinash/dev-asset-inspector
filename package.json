{
  "name": "dev-asset-inspector",
  "version": "1.0.0",
  "description": "Development asset inspector and optimization tool for React + Vite projects",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/styles.css": "./dist/react/styles.css",
    "./vite": {
      "types": "./dist/vite/assetInspectorPlugin.d.ts",
      "import": "./dist/vite/assetInspectorPlugin.js"
    }
  },
  "bin": {
    "dev-asset-inspector": "./bin/asset-inspector.js",
    "asset-inspector": "./bin/asset-inspector.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-assets.js && tsc && node scripts/copy-dist-css.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p4avinash/dev-asset-inspector.git"
  },
  "keywords": [
    "assets",
    "asset-inspector",
    "vite",
    "vite-plugin",
    "react",
    "devtools",
    "image-optimization",
    "duplicates"
  ],
  "author": "p4avinash",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/p4avinash/dev-asset-inspector/issues"
  },
  "homepage": "https://github.com/p4avinash/dev-asset-inspector#readme",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "file-type": "^22.0.2",
    "image-dimensions": "^2.5.1"
  }
}
